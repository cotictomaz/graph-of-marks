# Copy to .env and fill in.  Loaded by src/gom/utils/env.py at the top of the CLI
# entry points, and passed wholesale to containers via `docker --env-file`.
#
# Do NOT quote values: --env-file passes quotes through literally, so
# HF_TOKEN="hf_x" arrives inside the container as the 5-character string "hf_x".

# Required.  Gemma-3 is gated; without a token accepted on its model page the
# inference prefetch fails.
HF_TOKEN=

# Optional host-side Hugging Face cache.  The reproduction path ignores this and
# mounts --model-cache at /model-cache instead (see reproduction/README.md), so
# leave it unset unless you run the package outside Docker.
# HF_HOME=

# Optional, unused by the reproduction path.
# WANDB_API_KEY=
# OPENAI_API_KEY=
# ZLM_KEY=
